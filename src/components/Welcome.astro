<header
	class="relative w-full h-[60vh] min-h-[400px] flex items-center justify-center bg-[url('/images/sunset_bg.jpg')] bg-cover bg-center overflow-hidden"
>
	<div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
