<header
	class="relative w-full h-[60vh] min-h-[400px] flex items-end justify-center bg-[url('/images/sunset_bg.jpg')] bg-cover bg-center overflow-hidden pb-10 md:pb-16"
>
	<div
		class="relative z-10 text-center px-4 md:px-6 max-w-4xl mx-auto w-full"
	>
		<h1
			class="text-5xl md:text-7xl font-extrabold tracking-tight text-white drop-shadow-md mb-3 md:mb-2 leading-tight"
		>
			Sea Days & Sunsets
		</h1>
		<p
			class="text-[1.05rem] md:text-2xl font-medium text-slate-100 drop-shadow mb-6 max-w-2xl mx-auto px-2 md:px-0"
		>
			Come along on Kimberly &amp; James&apos; journeys. Traveling,
			cruising and gambling our way through retirement.
		</p>
		<a
			href="#links"
			class="inline-flex items-center justify-center px-8 py-3 text-base font-bold text-slate-900 bg-white rounded-full shadow-lg hover:bg-orange-100 hover:scale-105 transition-all duration-300"
		>
			Explore the Journey
		</a>
	</div>
</header>
<main id="links" class="flex-grow w-full max-w-3xl mx-auto px-6 py-20">
	<div class="text-center mb-12">
		<h2 class="text-3xl font-bold text-orange-400 mb-3">
			Join the Journey
		</h2>
		<p class="text-slate-300 text-lg">
			Help fuel future voyages and casino runs by connecting below.
		</p>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		<a
			href="https://youtube.com/@SeaDaysSunsets"
			target="_blank"
			rel="noopener noreferrer"
			class="group flex items-center p-8 md:py-10 bg-slate-800 rounded-2xl border border-slate-700 hover:border-red-500 hover:bg-slate-800/80 hover:-translate-y-1 transition-all duration-300 shadow-lg md:col-span-2"
		>
			<div
				class="w-16 h-16 md:w-20 md:h-20 flex-shrink-0 bg-slate-900/50 text-red-500 rounded-full flex items-center justify-center mr-6 group-hover:bg-red-500 group-hover:text-white transition-colors duration-300"
			>
				<svg
					class="w-8 h-8 md:w-10 md:h-10"
					fill="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
					></path>
				</svg>
			</div>
			<div>
				<h3
					class="text-2xl md:text-3xl font-bold text-slate-100 group-hover:text-red-400 transition-colors"
				>
					YouTube
				</h3>
				<p class="text-base text-slate-300 mt-2">
					Watch our latest videos.
				</p>
			</div>
		</a>

		<a
			href="https://www.instagram.com/seadayssunsets/"
			target="_blank"
			rel="noopener noreferrer"
			class="group flex items-center p-5 bg-slate-800 rounded-2xl border border-slate-700 hover:border-pink-500 hover:bg-slate-800/80 hover:-translate-y-1 transition-all duration-300 shadow-md"
		>
			<div
				class="w-14 h-14 flex-shrink-0 bg-slate-900/50 text-pink-500 rounded-full flex items-center justify-center mr-5 group-hover:bg-pink-500 group-hover:text-white transition-colors duration-300"
			>
				<svg
					class="w-7 h-7"
					fill="currentColor"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
					></path>
				</svg>
			</div>
			<div>
				<h3
					class="text-xl font-bold text-slate-100 group-hover:text-pink-500 transition-colors"
				>
					Instagram
				</h3>
				<p class="text-base text-slate-300 mt-1">
					See our latest cruise photos and reels.
				</p>
			</div>
		</a>

		<a
			href="https://buymeacoffee.com/"
			target="_blank"
			rel="noopener noreferrer"
			class="group flex items-center p-5 bg-slate-800 rounded-2xl border border-slate-700 hover:border-yellow-400 hover:bg-slate-800/80 hover:-translate-y-1 transition-all duration-300 shadow-md"
		>
			<div
				class="w-14 h-14 flex-shrink-0 bg-slate-900/50 text-yellow-400 rounded-full flex items-center justify-center mr-5 group-hover:bg-yellow-400 group-hover:text-slate-900 transition-colors duration-300"
			>
				<svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
					<path
						d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4z"
					></path>
				</svg>
			</div>
			<div>
				<h3
					class="text-xl font-bold text-slate-100 group-hover:text-yellow-400 transition-colors"
				>
					Buy us a coffee
				</h3>
				<p class="text-base text-slate-300 mt-1">
					Support the channel.
				</p>
			</div>
		</a>
	</div>
</main>
